# Copier ce fichier en .env puis renseigner les valeurs. Le fichier .env n'est jamais versionné.
#   Windows (PowerShell) : Copy-Item env.example .env
#   macOS / Linux        : cp env.example .env

# --- Obligatoire pour /ask et l'évaluation Ragas (https://console.mistral.ai/api-keys) ---
MISTRAL_API_KEY=

# --- Jeton protégeant POST /rebuild (en-tête X-Admin-Token). Vide = rebuild désactivé ---
ADMIN_TOKEN=change-moi

# --- Optionnel : valeurs par défaut ci-dessous ---
# OA_CITY=Toulouse
# OA_HISTORY_DAYS=365
# LLM_MODEL=mistral-small-latest
# LLM_TEMPERATURE=0.1
# TOP_K=5
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# INDEX_TYPE=flat
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
